# Python ignores
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Data and Models (Do not commit large/raw files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models_store/*
!models_store/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
reports/metrics/*
!reports/metrics/.gitkeep